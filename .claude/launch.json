{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "web-mocks",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "NEXT_PUBLIC_ENABLE_MOCKS=true npm run dev -- --port 3100"],
      "port": 3100
    },
    {
      "name": "design",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "8090", "docs/design"],
      "port": 8090
    }
  ]
}
